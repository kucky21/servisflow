# ServisHub – konfigurace prostředí
# Zkopírujte do .env a upravte. Soubor .env nikdy necommitujte.

# dev | production
APP_ENV=dev
# 1 = Tracy debug bar a detailní chyby (pouze lokálně!)
APP_DEBUG=1
APP_URL=http://localhost:8080
APP_PORT=8080

# PostgreSQL
DB_NAME=servishub
DB_USER=servishub
DB_PASSWORD=change-me-local-password
DB_PUBLISHED_PORT=54320

# Demo data – naplní se automaticky při startu, pouze pokud APP_ENV != production
# a databáze je prázdná.
SEED_DEMO_DATA=1
DEMO_PASSWORD=Demo1234!
