{layout none}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{$title} · ServisHub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{$basePath}/assets/css/app.css">
</head>
<body class="auth-body">
    <main class="auth-wrapper">
        <div class="auth-card text-center">
            <div class="error-code">{$httpCode}</div>
            <h1 class="h4 mb-2">{$title}</h1>
            <p class="text-secondary mb-4">{$message}</p>
            <a n:href="Dashboard:default" class="btn btn-primary" n:if="$isLoggedIn">Zpět na přehled</a>
            <a n:href="Sign:in" class="btn btn-primary" n:if="!$isLoggedIn">Přihlásit se</a>
        </div>
    </main>
</body>
</html>
